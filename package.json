{
  "name": "dlabs-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "Diabolical Labs platform toolkit — shared TypeScript infrastructure. © Diabolical Labs",
  "author": "Diana Ismail <diana@deeismail.com> (https://deeismail.com)",
  "publisher": "Diabolical Labs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannism/dlabs-toolkit.git"
  },
  "homepage": "https://github.com/mannism/dlabs-toolkit#readme",
  "bugs": {
    "url": "https://github.com/mannism/dlabs-toolkit/issues"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^2.31.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "ws": ">=8.21.0",
      "protobufjs": ">=8.6.6",
      "form-data": ">=4.0.6",
      "brace-expansion": ">=5.0.9",
      "nanoid": ">=3.3.17",
      "read-yaml-file>js-yaml": ">=3.15.1 <4.0.0",
      "@changesets/parse>js-yaml": ">=4.3.1 <5.0.0"
    }
  }
}
